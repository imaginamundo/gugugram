---
import ImagePost from "@components/post/ImagePost/ImagePost.svelte";
import type { PostType } from "@services/imagePost";

interface Props {
	posts: PostType[];
}

const { posts } = Astro.props;

// One payload for the whole grid rather than one serialized prop per post.
// `<` is escaped so a description can never close the script tag early.
const payload = JSON.stringify(posts).replace(/</g, "\\u003c");
---

<div class="flex justify-center flex-wrap">
	{
		posts.length === 0 ? (
			<p>Ainda sem nenhuma imagem :(</p>
		) : (
			posts.map((post, index) => <ImagePost {post} {index} />)
		)
	}
</div>

{
	posts.length > 0 && (
		<script type="application/json" data-image-post-payload is:inline set:html={payload} />
	)
}

<script>
	import { delegateImagePostClicks } from "@components/post/ImagePostList/delegateImagePostClicks";

	delegateImagePostClicks();
</script>
